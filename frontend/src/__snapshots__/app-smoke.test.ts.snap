// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`app smoke test > renders the same DOM as before 1`] = `
"<div id="app">
  <header class="dashboard-header">
    <h1>
      Starship Telemetry Dashboard
    </h1>
    <span class="dashboard-header__version" title="Version (release.commit)">
      vdev
    </span>
    <span class="dashboard-header__version dashboard-header__version--mismatch" id="backend-version" title="The backend runs v0.0.0.0, this page is vdev. Restart the backend (an old one may still be running) or reload the page.">
      backend v0.0.0.0
    </span>
  </header>
  <section class="dashboard-controls" aria-label="Pipeline Controls">
    <div id="pipeline-controls" class="pipeline-controls">
      <div class="pipeline-controls__url-row">
        <input type="url" placeholder="Paste livestream URL..." class="pipeline-controls__url-input" aria-label="Livestream URL" .value="">
        <button class="pipeline-controls__validate-btn" type="button">
          Validate
        </button>
      </div>
      <div class="pipeline-controls__interval-row">
        <label class="pipeline-controls__interval-label" for="interval-input">
          Process every:
        </label>
        <input type="number" id="interval-input" min="1" max="300" step="1" class="pipeline-controls__interval-input" aria-label="Process every Nth frame" .value="30">
        <span class="pipeline-controls__interval-unit">
          th frame
        </span>
      </div>
      <div class="pipeline-controls__status-row">
        <span class="pipeline-controls__validation-status" aria-live="polite"></span>
        <button class="pipeline-controls__action-btn" type="button" style="display: none;"></button>
        <span class="pipeline-controls__fps" aria-live="polite"></span>
        <span class="pipeline-controls__status-badge" aria-live="polite"></span>
      </div>
    </div>
    <div id="telemetry-downloads" class="telemetry-downloads">
      <span class="telemetry-downloads__label">
        OCR data:
      </span>
      <button type="button" class="telemetry-downloads__btn" data-format="flight" title="Speed, altitude and engines per frame in the results_previous/ format" disabled="">
        ↓ Flight JSON
      </button>
      <button type="button" class="telemetry-downloads__btn" data-format="raw" title="Every record exactly as received from the backend" disabled="">
        ↓ Raw records
      </button>
      <span class="telemetry-downloads__count" aria-live="polite">
        0 records
      </span>
    </div>
  </section>
  <section class="dashboard-main" aria-label="Telemetry and Frame">
    <div class="dashboard-main__telemetry">
      <div id="telemetry-display" class="telemetry-display">
        <div class="telemetry-display__met">
          <span class="telemetry-display__met-value" aria-label="Mission Elapsed Time">
            --:--:--
          </span>
        </div>
        <div class="telemetry-display__indicators">
          <span class="telemetry-display__badge telemetry-display__badge--inactive" aria-label="T-0 Detection Status">
            <span class="telemetry-display__badge-dot"></span>
            <span class="telemetry-display__badge-label">
              T-0
            </span>
          </span>
          <span class="telemetry-display__badge telemetry-display__badge--inactive" aria-label="Stage Separation Detection Status">
            <span class="telemetry-display__badge-dot"></span>
            <span class="telemetry-display__badge-label">
              STAGE SEP
            </span>
          </span>
        </div>
        <div class="telemetry-display__grid">
          <div class="telemetry-display__column">
            <div class="telemetry-display__column-header">
              L
            </div>
            <div class="telemetry-display__field-row">
              <span class="telemetry-display__field-label">
                SPD
              </span>
              <span class="telemetry-display__field-value">
                --
              </span>
            </div>
            <div class="telemetry-display__field-row">
              <span class="telemetry-display__field-label">
                ALT
              </span>
              <span class="telemetry-display__field-value">
                --
              </span>
            </div>
          </div>
          <div class="telemetry-display__column">
            <div class="telemetry-display__column-header">
              R
            </div>
            <div class="telemetry-display__field-row">
              <span class="telemetry-display__field-label">
                SPD
              </span>
              <span class="telemetry-display__field-value">
                --
              </span>
            </div>
            <div class="telemetry-display__field-row">
              <span class="telemetry-display__field-label">
                ALT
              </span>
              <span class="telemetry-display__field-value">
                --
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="dashboard-main__frame">
      <div id="frame-preview">
        <div class="frame-preview">
          <div class="frame-preview__header">
            <span class="frame-preview__title">
              Live Frame
            </span>
            <span class="frame-preview__stats">
              <span class="frame-preview__fps"></span>
              <span class="frame-preview__seq"></span>
            </span>
          </div>
          <div class="frame-preview__image-container">
            <img class="frame-preview__img" alt="Current processed frame">
            <div class="frame-preview__placeholder">
              No frame data
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="dashboard-engines" aria-label="Engine Status">

          </g>
          <g data-label="E5" role="img" aria-label="E5">
            <circle cx="42" cy="61" r="14.5" fill="#666666" stroke="#888888" stroke-width="0.5"></circle>
            <text x="42" y="61" text-anchor="middle" dominant-baseline="central" fill="#FEFEFE" font-family="'JetBrains Mono', monospace" font-weight="500" font-size="14.50">
              E5
            </text>
          </g>
          <g data-label="E6" role="img" aria-label="E6">
            <circle cx="15" cy="15" r="14.5" fill="#666666" stroke="#888888" stroke-width="0.5"></circle>
            <text x="15" y="15" text-anchor="middle" dominant-baseline="central" fill="#FEFEFE" font-family="'JetBrains Mono', monospace" font-weight="500" font-size="14.50">
              E6
            </text>
          </g>
        </svg>
      </div>
      <div class="engine-visualizer__legend" aria-label="Engine status legend">
        <div class="engine-visualizer__legend-item">
          <span class="engine-visualizer__legend-swatch" style="background-color: rgb(255, 128, 20); border-color: rgb(255, 160, 64);"></span>
          <span class="engine-visualizer__legend-label" title="Engine is firing">
            Active
          </span>
        </div>
        <div class="engine-visualizer__legend-item">
          <span class="engine-visualizer__legend-swatch" style="background-color: rgb(26, 26, 26); border-color: rgb(68, 68, 68);"></span>
          <span class="engine-visualizer__legend-label" title="Engine is off">
            Inactive
          </span>
        </div>
        <div class="engine-visualizer__legend-item">
          <span class="engine-visualizer__legend-swatch" style="background-color: rgb(102, 102, 102); border-color: rgb(136, 136, 136);"></span>
          <span class="engine-visualizer__legend-label" title="Status unknown">
            Undetected
          </span>
        </div>
      </div>
    </div>
  </section>
  <section class="dashboard-globe" aria-label="Ship Position">
    <div id="ship-globe" class="ship-globe">
      <div class="ship-globe__header">
        <h2 class="ship-globe__heading">
          Ship Position
        </h2>
        <div class="ship-globe__downloads" role="group" aria-label="Download live tracks" hidden="" data-tracks=""></div>
      </div>
      <div class="ship-globe__history" hidden="">
        <span class="ship-globe__history-label">
          Previous ships:
        </span>
        <div class="ship-globe__history-toggles"></div>
        <span class="ship-globe__gradient-legend" aria-label="Paths fade from launch to end">
          start
          <span class="ship-globe__gradient-bar"></span>
          end
        </span>
      </div>
      <div class="ship-globe__body">
        <div class="ship-globe__map">
          <div class="ship-globe__canvas-wrap">
            <canvas class="ship-globe__canvas" aria-label="Globe showing the ship's position. Drag to rotate, scroll to zoom."></canvas>
            <div class="ship-globe__zoom" role="group" aria-label="Globe view">
              <button type="button" class="ship-globe__zoom-btn ship-globe__center-btn" aria-label="Center on ship" title="Center on ship" disabled="">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <circle cx="12" cy="12" r="7"></circle>
                  <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none"></circle>
                  <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
                </svg>
              </button>
              <button type="button" class="ship-globe__zoom-btn" data-zoom="in" aria-label="Zoom in" title="Zoom in">
                +
              </button>
              <button type="button" class="ship-globe__zoom-btn" data-zoom="out" aria-label="Zoom out" title="Zoom out">
                −
              </button>
              <button type="button" class="ship-globe__zoom-btn ship-globe__zoom-level" data-zoom="reset" aria-label="Reset zoom" title="Reset zoom">
                1.0×
              </button>
            </div>
          </div>
          <p class="ship-globe__hint">
            Drag to rotate · Scroll to zoom
          </p>
        </div>
        <aside class="ship-globe__panel" aria-label="Active ship">
          <h3 class="ship-globe__panel-title">
            Active ship
          </h3>
          <div class="ship-globe__readout" aria-live="polite">
            <p class="ship-globe__empty">
              No ship above ground in the SpaceX tracker feed.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
  <section class="dashboard-graphs" aria-label="Time-Series Graphs">
    <div id="time-series-graphs">
      <div class="time-series-graphs">
        <div class="time-series-graphs__header">
          <h2 class="time-series-graphs__heading">
            Time-Series
          </h2>
          <div class="time-series-graphs__controls">
            <select class="time-series-graphs__select" aria-label="Select data series" .value="speedSuperHeavy">
              <option value="speedSuperHeavy">
                Speed — Super Heavy
              </option>
              <option value="speedStarship">
                Speed — Starship
              </option>
              <option value="altitudeSuperHeavy">
                Altitude — Super Heavy
              </option>
              <option value="altitudeStarship">
                Altitude — Starship
              </option>
              <option value="accelerationSuperHeavy">
                Acceleration — Super Heavy
              </option>
              <option value="accelerationStarship">
                Acceleration — Starship
              </option>
            </select>
            <button class="time-series-graphs__reset-btn" aria-label="Reset zoom">
              Reset Zoom
            </button>
            <div class="time-series-graphs__export">
              <button type="button" class="time-series-graphs__save-btn" aria-label="Save chart as PNG image" aria-haspopup="dialog" aria-expanded="false" aria-controls="time-series-graphs-export-#">
                Save PNG ▾
              </button>
              <div id="time-series-graphs-export-#" class="time-series-graphs__export-panel" role="dialog" aria-label="PNG export options" hidden="">
                <label class="time-series-graphs__export-field">
                  <span class="time-series-graphs__export-label">
                    Font size
                  </span>
                  <select class="time-series-graphs__select time-series-graphs__export-font" .value="10">
                    <option value="10">
                      10 px (default)
                    </option>
                    <option value="12">
                      12 px
                    </option>
                    <option value="14">
                      14 px
                    </option>
                    <option value="16">
                      16 px
                    </option>
                    <option value="20">
                      20 px
                    </option>
                    <option value="24">
                      24 px
                    </option>
                  </select>
                </label>
                <fieldset class="time-series-graphs__export-field">
                  <legend class="time-series-graphs__export-label">
                    Background
                  </legend>
                  <div class="time-series-graphs__export-segments">
                    <label class="time-series-graphs__export-segment">
                      <input type="radio" name="time-series-graphs-export-#-background" value="dark" .checked="true">
                      <span class="time-series-graphs__export-swatch time-series-graphs__export-swatch--dark" aria-hidden="true"></span>
                      <span>
                        Dark
                      </span>
                    </label>
                    <label class="time-series-graphs__export-segment">
                      <input type="radio" name="time-series-graphs-export-#-background" value="white" .checked="false">
                      <span class="time-series-graphs__export-swatch time-series-graphs__export-swatch--white" aria-hidden="true"></span>
                      <span>
                        White
                      </span>
                    </label>
                    <label class="time-series-graphs__export-segment">
                      <input type="radio" name="time-series-graphs-export-#-background" value="transparent" .checked="false">
                      <span class="time-series-graphs__export-swatch time-series-graphs__export-swatch--transparent" aria-hidden="true"></span>
                      <span>
                        Transparent
                      </span>
                    </label>
                  </div>
                </fieldset>
                <button type="button" class="time-series-graphs__export-download">
                  Download PNG
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="time-series-graphs__toolbar">
          <div class="time-series-graphs__compare-wrapper">
            <span class="time-series-graphs__compare-label">
              Compare:
            </span>
            <div class="time-series-graphs__compare-options"></div>
          </div>
          <span class="time-series-graphs__zoom-hint">
            Drag to pan · Ctrl+Drag to zoom · Scroll to zoom
          </span>
        </div>
        <div class="time-series-graphs__canvas-container">
          <canvas id="chart-main" style="display: block; box-sizing: border-box; touch-action: none; user-select: none; height: 0px; width: 0px;" height="0" width="0"></canvas>
          <div class="time-series-graphs__loading" role="status" hidden="">
            <span class="time-series-graphs__spinner" aria-hidden="true"></span>
            <span class="time-series-graphs__loading-text">
              Loading comparison data…
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
<div class="engine-tooltip" role="tooltip" hidden="">
  <span class="engine-tooltip__engine"></span>
  <span class="engine-tooltip__serial"></span>
</div>"
`;
